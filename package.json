{
  "name": "dsh-tree",
  "version": "0.1.0",
  "description": "DeepSeek Harness 对话树：把一个对话的所有分支画成一棵可点击的树",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "pretest": "node build.mjs",
    "test": "node test.mjs && node test-highlight.mjs && node test-elide.mjs && node test-branch.mjs && node test-icon.mjs && node test-rewind.mjs && node test-merge.mjs && node test-shape.mjs && node test-http.mjs && node test-net.mjs && node test-lifecycle.mjs && node test-tidy.mjs && node test-pointer.mjs && node test-layout.mjs && node test-split.mjs"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "docs",
    "build.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "AGENTS.md",
    "ARCHITECTURE.md",
    "DESIGN.md",
    "NATIVE-BASELINE.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "branch",
    "tree",
    "conversation"
  ],
  "license": "MIT",
  "author": "Rongjie Jiang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JRJRJPRO/dsh-tree.git"
  },
  "homepage": "https://github.com/JRJRJPRO/dsh-tree#readme",
  "bugs": {
    "url": "https://github.com/JRJRJPRO/dsh-tree/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.2"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  }
}
